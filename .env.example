# Google Civic Information API (server-side): polling places, elections, contests
GOOGLE_CIVIC_API_KEY=

# Google Maps Geocoding API (server-side)
GOOGLE_MAPS_API_KEY=

# Google Maps JavaScript API with Places (browser-side, restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Auth.js / next-auth (optional Google sign-in)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
